# -----------------------------------------------------------------------------
# Template for local secrets. Copy to `.env` and replace every CHANGE_ME value:
#     cp .env.example .env
#
# `.env` is git-ignored — never commit real passwords.
#
# Password rules for SQL Server (CHECK_POLICY is enforced):
#   - at least 8 characters, ideally 16+
#   - 3 of 4 categories: UPPER, lower, digit, symbol
#   - avoid  ;  "  '  $  and spaces (they break connection strings / .env parsing)
# -----------------------------------------------------------------------------

# SQL Server system administrator (used only by the db-init container).
MSSQL_SA_PASSWORD=CHANGE_ME_strong_sa_password

# SQL Server edition: Developer (free, full-featured) or Express.
MSSQL_PID=Developer

# Application database + least-privilege login the API connects with.
DB_NAME=NursingHome
DB_APP_USER=nursinghome_app
DB_APP_PASSWORD=CHANGE_ME_strong_app_password

# API host port (container always listens on 8080 internally).
API_PORT=8080

# ASPNETCORE_ENVIRONMENT: Development enables Swagger UI at /swagger; use Production to harden.
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=...
Jwt__Issuer=...
Jwt__Audience=...
Jwt__ExpirationMinutes=60
EmailSettings__Host=smtp.gmail.com
EmailSettings__Port=587
EmailSettings__Username=your-email@gmail.com
EmailSettings__Password=xxxxxxxxxxxxxxxx
EmailSettings__SenderEmail=your-email@gmail.com
EmailSettings__SenderName=Nursing Home
EmailSettings__UseSSL=true
